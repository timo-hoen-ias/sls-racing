// Local test of the leaderboard API (npm run online:dev): the real Worker with a local D1 database and a test
// player instead of Cloudflare Access (?as=name@x.de picks another one). Serves the last `npm run build`.
{
  "name": "sls-racing-dev",
  "compatibility_date": "2026-10-01",
  "main": "index.ts",
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "", "DEV_NO_AUTH": "1" },
  "d1_databases": [{ "binding": "DB", "database_name": "sls-racing-dev", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
