// Cloudflare Workers deployment: serves the static Vite build from ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sls-racing",
  "compatibility_date": "2026-10-01",
  // The deploy does not build the world itself any more: pipeline/deploy-tiles.ts downloads the finished tiles
  // that the GitHub world build published for the current world key (waiting for that build when it is still
  // running) and only falls back to world:fetch + world:build here (~30 min) when there is nothing to wait for.
  // vite copies public/tiles into dist, so they are served as static assets next to the game (unchanged files
  // are not uploaded again). Move them to R2 once the world outgrows asset limits.
  "build": { "command": "npm run world:deploy && npm run build" },
  // The Worker (worker/index.ts) only answers /api/* (leaderboards, O1); every other path is a static file.
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Cloudflare Access in front of the game (team domain and AUD tag of the Access application) and the D1
  // database of the leaderboards. Until they are filled in the API answers 503 and the game plays offline.
  // ONLINE_PUBLIC: online play (/api/net) open to everyone without Access (timo, 2026-10-25), with a name
  // filter and flood limits; the leaderboards keep their own rules.
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "", "ONLINE_PUBLIC": "1" },
  // Online play (O2): one Durable Object per server (worker/lobby.ts) and the server list (worker/directory.ts).
  // Public with ONLINE_PUBLIC=1, otherwise only behind Cloudflare Access like the rest of /api.
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }, { "name": "DIRECTORY", "class_name": "Directory" }] },
  "migrations": [{ "tag": "v1-online", "new_sqlite_classes": ["Lobby", "Directory"] }],
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches.
  "previews": {}
}
